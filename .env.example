# =========================================================
# CivicBot - tệp cấu hình mẫu
# Sao chép thành .env rồi điền giá trị thật:  copy .env.example .env
# KHÔNG commit tệp .env lên GitHub (đã có trong .gitignore).
# =========================================================

# --- AI (Google Gemini) ---
# AI_MODE=gemini : dùng Gemini khi CSDL không đủ để trả lời
# AI_MODE=off    : chỉ dùng CSDL nội bộ (dùng khi demo không có mạng / chạy test)
AI_MODE=gemini

# GENERAL_QA=true  : cho phép Gemini trả lời câu hỏi kiến thức chung (ngoài lề),
#                   luôn kèm nhãn "thông tin tham khảo do AI"
# GENERAL_QA=false : từ chối lịch sự câu hỏi không liên quan thủ tục hành chính
GENERAL_QA=true

# Thời gian chờ tối đa (giây) cho mỗi lần gọi Gemini
GEMINI_TIMEOUT=25
# Số lần thử lại khi Gemini quá tải (lỗi 503) và model dự phòng (tùy chọn)
GEMINI_RETRIES=2
GEMINI_FALLBACK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- MySQL ---
# Docker tự đặt MYSQL_HOST=mysql; giá trị dưới dùng khi chạy backend trực tiếp trên máy
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=civicbot
MYSQL_USER=civicbot
MYSQL_PASSWORD=doi_mat_khau_nay
MYSQL_ROOT_PASSWORD=doi_mat_khau_root_nay

# --- Bảo mật ---
# Khóa quản trị: cần cho /api/system-tests/run và xóa toàn bộ lịch sử
ADMIN_API_KEY=doi_khoa_quan_tri_nay
# Số câu hỏi tối đa / phút / địa chỉ IP
RATE_LIMIT_PER_MINUTE=30
# Dung lượng tệp tải lên tối đa (MB)
MAX_UPLOAD_MB=5
# Giữ lại tệp người dùng tải lên sau khi xử lý (false = xóa ngay)
KEEP_UPLOADS=false
# Nguồn giao diện được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
